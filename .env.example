# BloodLink configuration
# Copy to .env for local development. NEVER commit .env.

# Environment: "production" enforces Secure cookies and refuses the default SECRET_KEY.
ENV=development

# 64 hex chars (32 bytes). REQUIRED in production. Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-this-is-not-a-real-secret-do-not-use

# Database. SQLite for local dev; Postgres for production.
DATABASE_URL=sqlite:///./bloodlink.db
# Example Postgres: postgresql+psycopg://bloodlink:bloodlink@localhost:5432/bloodlink

# Optional: seed a coordinator on first start when none exists.
SEED_COORDINATOR_USERNAME=coordinator
SEED_COORDINATOR_PASSWORD=

# Demo mode: shows a banner, uses fake data only, disables Telegram.
DEMO_MODE=false

# Telegram bot (optional). When unset, all Telegram features are hidden and the webhook returns 404.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=

# Display timezone for dates/times shown to users.
DISPLAY_TIMEZONE=Asia/Dhaka

# Matching behavior.
MIN_DONATION_GAP_DAYS=120
RECENT_CONTACT_HOURS=24
RETENTION_DAYS=30

# Public counts: cells with fewer than this many verified donors show "fewer than N".
SMALL_NUMBER_SUPPRESSION_THRESHOLD=3